{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Watch server dependencies",
            "type": "shell",
            "command": "pnpm",
            "args": ["dev:deps"],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "isBackground": true,
            "problemMatcher": {
                "owner": "typescript",
                "pattern": {
                    "regexp": "^$"
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": ".",
                    "endsPattern": "Watching for file changes"
                }
            },
            "presentation": {
                "reveal": "silent",
                "panel": "dedicated",
                "group": "watch"
            }
        }
    ]
}
